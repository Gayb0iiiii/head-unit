+// GPL-3.0-or-later. Head-unit patch against LIVI 4bcd1335c2daedba40640e6dc432cd2ed7acfaa4.
+// Internal connection ownership only; no change to protocol 8.
+use super::*;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+#[derive(Debug, PartialEq)]
+pub enum UiInput {
+    Input { client: u64, input: Input },
+    Disconnected { client: u64 },
+}
+
+/// Dropping an authenticated connection queues cleanup after its input, even on task abort.
+pub struct InputPeer {
+    id: u64,
+    tx: mpsc::UnboundedSender<UiInput>,
+}
+impl InputPeer {
+    pub fn new(tx: mpsc::UnboundedSender<UiInput>) -> std::io::Result<Self> {
+        static NEXT: AtomicU64 = AtomicU64::new(1);
+        let id = NEXT
+            .try_update(Ordering::Relaxed, Ordering::Relaxed, |n| n.checked_add(1))
+            .map_err(|_| std::io::Error::other("input connection identities exhausted"))?;
+        Ok(Self { id, tx })
+    }
+    pub fn send(&self, input: Input) {
+        let _ = self.tx.send(UiInput::Input { client: self.id, input });
+    }
+}
+impl Drop for InputPeer {
+    fn drop(&mut self) {
+        let _ = self.tx.send(UiInput::Disconnected { client: self.id });
+    }
+}
+
+pub(super) struct HeldInput {
+    client: u64,
+    link: Link,
+    front: Front,
+    // CP: last complete vector, including inactive slots. AA: active IDs in stream coordinates.
+    points: Vec<Point>,
+    voice: Option<String>,
+    button: Option<Key>,
+    select_due: Option<tokio::time::Instant>,
+}
+impl HeldInput {
+    fn empty(&self) -> bool {
+        self.points.iter().all(|p| matches!(p.phase, Phase::Up | Phase::Cancel))
+            && self.voice.is_none()
+            && self.button.is_none()
+    }
+}
+impl Projection {
+    pub(super) fn input_due(&self) -> Option<tokio::time::Instant> {
+        self.held_input.as_ref().and_then(|h| h.select_due)
+    }
+    pub(super) fn release_due_input(&mut self) {
+        if self.input_due().is_some_and(|due| due <= tokio::time::Instant::now()) {
+            self.release_owned_button();
+            self.clear_empty_input();
+        }
+    }
+    fn clear_empty_input(&mut self) {
+        if self.held_input.as_ref().is_some_and(HeldInput::empty) {
+            self.held_input = None;
+        }
+    }
+    pub(super) fn invalidate_owned_input(&mut self) {
+        if self.held_input.as_ref().is_some_and(|h| {
+            Some(h.link) != self.active().map(|s| s.link) || h.front != self.front_main()
+        }) {
+            self.release_owned_input();
+        }
+    }
+    fn owned_button(&self, link: Link, key: Key) {
+        match link {
+            Link::Cp(id) => self
+                .cp
+                .stack(id, StackCmd::KnobSelect(matches!(key, Key::KnobDown | Key::SelectDown))),
+            Link::Aa(id) => {
+                let cmd = match key {
+                    Key::KnobDown => Command::KnobDown,
+                    Key::KnobUp => Command::KnobUp,
+                    Key::SelectDown => Command::SelectDown,
+                    Key::SelectUp => Command::SelectUp,
+                    _ => return,
+                };
+                self.aa.session(id, SessionCmd::Command(cmd));
+            }
+        }
+    }
+    fn release_owned_button(&mut self) {
+        let release = self.held_input.as_mut().and_then(|h| {
+            h.select_due = None;
+            h.button
+                .take()
+                .map(|key| (h.link, if key == Key::KnobDown { Key::KnobUp } else { Key::SelectUp }))
+        });
+        if let Some((link, key)) = release {
+            self.owned_button(link, key);
+        }
+    }
+    fn owned_points(&self, link: Link, points: &[Point]) {
+        match link {
+            Link::Cp(id) => self.cp.stack(
+                id,
+                StackCmd::Touches(
+                    points
+                        .iter()
+                        .map(|p| Touch {
+                            x: p.x,
+                            y: p.y,
+                            down: !matches!(p.phase, Phase::Up | Phase::Cancel),
+                        })
+                        .collect(),
+                ),
+            ),
+            Link::Aa(id) => self.aa.session(
+                id,
+                SessionCmd::MultiTouch(
+                    points
+                        .iter()
+                        .map(|p| TouchItem {
+                            id: p.id,
+                            x: p.x,
+                            y: p.y,
+                            action: match p.phase {
+                                Phase::Down => TouchAction::Down,
+                                Phase::Move => TouchAction::Move,
+                                _ => TouchAction::Up,
+                            },
+                        })
+                        .collect(),
+                ),
+            ),
+        }
+    }
+    pub(super) fn release_owned_input(&mut self) {
+        let Some(mut held) = self.held_input.take() else { return };
+        if held.points.iter().any(|p| !matches!(p.phase, Phase::Up | Phase::Cancel)) {
+            if matches!(held.link, Link::Aa(_)) {
+                // The session's geometry-aware ledger releases at the last accepted
+                // position if the final point is outside its picture/cut-outs.
+                let mut points = held.points;
+                while !points.is_empty() {
+                    for p in &mut points {
+                        p.phase = Phase::Move;
+                    }
+                    points[0].phase = Phase::Cancel;
+                    self.owned_points(held.link, &points);
+                    points.remove(0);
+                }
+            } else {
+                for p in &mut held.points {
+                    p.phase = Phase::Cancel;
+                }
+                self.owned_points(held.link, &held.points);
+            }
+        }
+        if held.voice.is_some()
+            && let Link::Aa(id) = held.link
+        {
+            self.aa.session(id, SessionCmd::Command(Command::VoiceAssistantRelease));
+        }
+        if let Some(key) = held.button {
+            self.owned_button(
+                held.link,
+                if key == Key::KnobDown { Key::KnobUp } else { Key::SelectUp },
+            );
+        }
+    }
+    pub(super) fn client_input(&mut self, event: UiInput) {
+        self.invalidate_owned_input();
+        let (client, input) = match event {
+            UiInput::Disconnected { client } => {
+                if self.held_input.as_ref().is_some_and(|h| h.client == client) {
+                    self.release_owned_input();
+                }
+                return;
+            }
+            UiInput::Input { client, input } => (client, input),
+        };
+        // One connection owns a held sequence; other clients cannot overwrite or release it.
+        if self.held_input.as_ref().is_some_and(|h| h.client != client) {
+            return;
+        }
+        let Some(link) = self.active().map(|s| s.link) else {
+            // Preserve non-phone actions such as cluster layout and DAB controls.
+            if let Input::Key { code, down } = input {
+                self.key(&code, down);
+            }
+            return;
+        };
+        match input {
+            Input::Pointer { screen: Screen::Main, mut points } => {
+                if self.front_main() != Front::Projection || points.is_empty() || points.len() > 10
+                {
+                    return;
+                }
+                let old = self.held_input.as_ref().map(|h| h.points.as_slice()).unwrap_or(&[]);
+                for (i, p) in points.iter().enumerate() {
+                    let active = old
+                        .iter()
+                        .any(|q| q.id == p.id && !matches!(q.phase, Phase::Up | Phase::Cancel));
+                    if p.id >= 10
+                        || !p.x.is_finite()
+                        || !p.y.is_finite()
+                        || points[..i].iter().any(|q| q.id == p.id)
+                        || (matches!(p.phase, Phase::Down) && active)
+                        || (!matches!(p.phase, Phase::Down) && !active)
+                    {
+                        return;
+                    }
+                }
+                let crop = *self.aa_crop.borrow();
+                for p in &mut points {
+                    p.x = p.x.clamp(0.0, 1.0);
+                    p.y = p.y.clamp(0.0, 1.0);
+                    if matches!(link, Link::Aa(_)) {
+                        (p.x, p.y) = android_auto::to_stream(p.x, p.y, crop.as_ref());
+                    }
+                }
+                // Validate the complete new contact set before emitting any packet.
+                if matches!(link, Link::Aa(_)) {
+                    let retained =
+                        old.iter().filter(|p| !points.iter().any(|q| q.id == p.id)).count();
+                    if retained
+                        + points
+                            .iter()
+                            .filter(|p| !matches!(p.phase, Phase::Up | Phase::Cancel))
+                            .count()
+                        > 10
+                    {
+                        return;
+                    }
+                }
+                if matches!(link, Link::Cp(_)) {
+                    // Apply existing releases/moves before allocating new stable HID slots.
+                    let mut slots = old.to_vec();
+                    for p in points.iter().filter(|p| p.phase != Phase::Down) {
+                        if let Some(slot) = slots.iter_mut().find(|q| q.id == p.id) {
+                            *slot = *p;
+                        }
+                    }
+                    let ending = slots.clone();
+                    let mut added = false;
+                    for p in points.iter().filter(|p| p.phase == Phase::Down) {
+                        added = true;
+                        if let Some(slot) =
+                            slots.iter_mut().find(|q| matches!(q.phase, Phase::Up | Phase::Cancel))
+                        {
+                            *slot = *p;
+                        } else {
+                            slots.push(*p);
+                        }
+                    }
+                    if slots.len() > livi_cp::hid::TOUCH_CONTACTS {
+                        self.release_owned_input();
+                        return;
+                    }
+                    if added && points.iter().any(|p| matches!(p.phase, Phase::Up | Phase::Cancel))
+                    {
+                        self.owned_points(link, &ending);
+                    }
+                    self.owned_points(link, &slots);
+                    self.hold(client, link).points = slots;
+                } else {
+                    let mut state = old.to_vec();
+                    for p in &mut state {
+                        p.phase = Phase::Move;
+                        if let Some(next) =
+                            points.iter().find(|q| q.id == p.id && q.phase == Phase::Move)
+                        {
+                            *p = *next;
+                        }
+                    }
+                    let mut emitted = false;
+                    for p in points.iter().filter(|p| p.phase != Phase::Move) {
+                        if p.phase == Phase::Down {
+                            state.push(*p);
+                        } else if let Some(old) = state.iter_mut().find(|q| q.id == p.id) {
+                            *old = *p;
+                        }
+                        self.owned_points(link, &state);
+                        state.retain(|q| !matches!(q.phase, Phase::Up | Phase::Cancel));
+                        for q in &mut state {
+                            q.phase = Phase::Move;
+                        }
+                        emitted = true;
+                    }
+                    if !emitted {
+                        self.owned_points(link, &state);
+                    }
+                    self.hold(client, link).points = state;
+                }
+            }
+            Input::Pointer { .. } => return,
+            Input::Key { code, down } => {
+                if code.len() > 128 {
+                    return;
+                }
+                // Match the press-time PTT code before looking at mutable bindings.
+                if !down
+                    && self.held_input.as_ref().is_some_and(|h| h.voice.as_ref() == Some(&code))
+                {
+                    if let Link::Aa(id) = link {
+                        self.aa.session(id, SessionCmd::Command(Command::VoiceAssistantRelease));
+                    }
+                    self.held_input.as_mut().unwrap().voice = None;
+                } else {
+                    let Some(key) = bound(&self.bindings, &code) else { return };
+                    if !down {
+                        return;
+                    }
+                    match key {
+                        Key::VoiceAssistantRelease => {
+                            if self.held_input.as_ref().is_some_and(|h| h.voice.is_some()) {
+                                if let Link::Aa(id) = link {
+                                    self.aa.session(
+                                        id,
+                                        SessionCmd::Command(Command::VoiceAssistantRelease),
+                                    );
+                                }
+                                self.held_input.as_mut().unwrap().voice = None;
+                            }
+                        }
+                        Key::SelectUp | Key::KnobUp => {
+                            let expected =
+                                if key == Key::SelectUp { Key::SelectDown } else { Key::KnobDown };
+                            if self.held_input.as_ref().is_some_and(|h| h.button == Some(expected))
+                            {
+                                self.release_owned_button();
+                            }
+                        }
+                        Key::VoiceAssistant if matches!(link, Link::Aa(_)) => {
+                            if self.held_input.as_ref().is_some_and(|h| h.voice.is_some()) {
+                                return;
+                            }
+                            self.aa_key(
+                                match link {
+                                    Link::Aa(id) => id,
+                                    _ => unreachable!(),
+                                },
+                                key,
+                                true,
+                            );
+                            self.hold(client, link).voice = Some(code);
+                        }
+                        Key::SelectDown | Key::KnobDown => {
+                            if self.front_main() != Front::Projection
+                                || self.held_input.as_ref().is_some_and(|h| h.button.is_some())
+                            {
+                                return;
+                            }
+                            self.owned_button(link, key);
+                            let h = self.hold(client, link);
+                            h.button = Some(key);
+                            h.select_due = (key == Key::SelectDown)
+                                .then(|| tokio::time::Instant::now() + SELECT_RELEASE);
+                        }
+                        _ => self.key(&code, down),
+                    }
+                }
+            }
+        }
+        self.clear_empty_input();
+    }
+    fn hold(&mut self, client: u64, link: Link) -> &mut HeldInput {
+        let front = self.front_main();
+        self.held_input.get_or_insert_with(|| HeldInput {
+            client,
+            link,
+            front,
+            points: Vec::new(),
+            voice: None,
+            button: None,
+            select_due: None,
+        })
+    }
+}
+impl Drop for Projection {
+    fn drop(&mut self) {
+        self.release_owned_input();
+    }
+}
