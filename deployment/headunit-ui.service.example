# NOT BOOT-ACCEPTED: see docs/pi-install-recovery-plan.md foreground gate.
[Unit]
Description=Headunit Wayland system interface
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=3
OnFailure=getty@tty1.service

[Service]
Type=simple
User=cruiser
PAMName=login
Environment=XDG_SESSION_TYPE=wayland
EnvironmentFile=-/etc/default/headunit-ui
WorkingDirectory=/home/cruiser/head-unit
ExecStart=/home/cruiser/head-unit/deployment/orangepi-ui-launch.sh
TTYPath=/dev/tty1
StandardInput=tty-force
TTYReset=yes
TTYVHangup=yes
StandardOutput=journal
StandardError=journal
Restart=always
RestartPreventExitStatus=78
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
